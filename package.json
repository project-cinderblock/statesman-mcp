{
  "name": "statesman-mcp",
  "version": "1.1.0",
  "description": "Model Context Protocol (MCP) server for Statesman comparative geopolitics, statecraft, and urban power centers platform",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "statesman-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leouofa/statesman-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "statesman",
    "comparative-geopolitics",
    "statecraft",
    "pgvector",
    "clustering",
    "ai-agent"
  ],
  "author": "Leonid Medovyy <leonid@macron1.io>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/leouofa/statesman-mcp/issues"
  },
  "homepage": "https://github.com/leouofa/statesman-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "axios": "^1.21.1",
    "dotenv": "^18.0.10",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "axios-mock-adapter": "^2.1.0",
    "rimraf": "^6.1.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
